  ground: "#e4e4e8",

  mark: "#ffffff",
  line: "#ffc21e",
} as const;

const EVERY = 3;

const MAX_LEN = 0.26;

const ROOT = 0.006;

const ROUGH = 0.007;

const STEP = 0.006;

const LINE_W = 0.0032;

const RUN = 9;

const BREATH_RATE = 0.55;

const BREATH_AMT = 0.1;

const SWAY_AMT = 0.06;

const REPEL = 0.34;

const REACH_RATIO = 0.3;

const SPRING = 0.055;
const DAMP = 0.86;

const MAGNET = 0.012;

const MAGNET_REACH = 0.34;
const MAGNET_SPRING = 0.05;
const MAGNET_DAMP = 0.87;

const GROW_AMT = 0.9;

const HUE_FROM = 43.7;
const SAT_FROM = 100;
const LIT_FROM = 55.9;
const HUE_TO = 104;
const SAT_TO = 64;
const LIT_TO = 38;

const HUE_STEPS = 24;

const HUE_REACH = 0.22;

const HUE_RAMP: string[] = Array.from({ length: HUE_STEPS }, (_, i) => {
  const u = i / (HUE_STEPS - 1);

  const e = u * u * (3 - 2 * u);
  const hue = HUE_FROM + (HUE_TO - HUE_FROM) * e;
  const sat = SAT_FROM + (SAT_TO - SAT_FROM) * e;
  const lit = LIT_FROM + (LIT_TO - LIT_FROM) * e;
